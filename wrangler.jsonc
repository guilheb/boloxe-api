{
  "name": "boloxe-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },

  // Replaces Redis. Without an id, `wrangler deploy` creates the namespace on the first deploy.
  "kv_namespaces": [
    { "binding": "CACHE" }
  ],

  // Replaces cron.php: refreshes the Flickr albums in the cache
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Custom domain: Cloudflare creates the DNS record and the certificate on deploy
  "routes": [
    { "pattern": "api2.boloxe.com", "custom_domain": true }
  ]

  // The secrets (INTERNAL_API_KEY, FLICKR_*, CAL_<ID>_*) are set with `wrangler secret put` or `wrangler secret bulk`
  // and read from .env by `wrangler dev`
}
